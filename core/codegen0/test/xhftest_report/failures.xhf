# Deliberately failing items, used by ../xhftest_report.test.ts.
# <yatt:test_nimpl/> is a macro defined there which always calls ctx.NIMPL(),
# so that these items do not depend on what is left unimplemented.

TITLE: runtime throw
IN:
 <!yatt:args x>
 &yatt:boom(:x);
 <!yatt:entity boom x>
 throw new Error("boom in entity");
OUT: never

TITLE: bad generated code
IN:
 <!yatt:args x>
 &yatt:bad(:x);
 <!yatt:entity bad x>
 return ((((;
OUT: never

TITLE: compile failure
IN:
 <!yatt:args x>
 <yatt:nosuch/>
PARAM[
- 1
]
OUT: one

TITLE: compile failure, next param
PARAM[
- 2
]
OUT: two

TITLE: wrong output
IN: aaa
OUT: bbb

TITLE: nimpl
IN:
 <!yatt:args x>
 <yatt:test_nimpl/>
PARAM[
- 1
]
OUT: one

TITLE: nimpl, next param
PARAM[
- 2
]
OUT: two

TITLE: nimpl where an error is expected
IN:
 <!yatt:args x>
 <yatt:test_nimpl/>
ERROR: never matches
